--- !u!114 &837915054
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 837915050}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a8e31a8a587cad4d8f1c082223ad42f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextSequencePlayer
  onEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 837915055}
        m_TargetAssemblyTypeName: SceneTeleporter, Assembly-CSharp
        m_MethodName: SceneChange
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  textEntries:
  - text: "\uADF8\uB807\uAC8C \uBBF8\uC6C0\uBC1B\uB294 \uC54C\uD30C\uCE74\uB294\n\uACB0\uAD6D
      \uBD80\uD488 3\uAC1C\uB97C \uC804\uBD80 \uCC3E\uC544\uC11C \uD575\uD3ED\uD0C4\uC744
      \uC791\uB3D9\uC2DC\uCF30\uB2E4."
  - text: "\uCFE0\uC6B0\uC6B0\uC6C5! \uB545\uC774 \uC6B8\uB9AC\uBA74\uC11C \uD575
      \uD3ED\uD0C4\uC774 \uBC1C\uC0AC\uB418\uC5C8\uB2E4."
  - text: "\uD575\uD3ED\uD0C4\uC740 \uBB34\uC12D\uAC8C \uD558\uB298\uC744 \uAC00\uB974\uBA74\uC11C
      \uB0A0\uC544\uAC00\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - text: "\uBBF8\uC6C0\uBC1B\uB294 \uC54C\uD30C\uCE74\uB294 \uC11C\uB458\uB7EC \uCD5C\uC2E0\uD615
      \uB9DD\uC6D0\uACBD\uC73C\uB85C \uB6F0\uC5B4\uAC00\n\uC54C\uD30C\uCE74 \uB9C8\uC744\uC744
      \uC9C0\uCF1C\uBCF4\uC558\uB2E4."
  - text: "\uBA87\uCD08 \uB4A4, \uD575\uD3ED\uD0C4\uC740 \uC54C\uD30C\uCE74 \uB9C8\uC744\uC5D0
      \uB5A8\uC5B4\uC84C\uACE0,\n\uCEE4\uB2E4\uB780 \uAD49\uC74C\uACFC \uD568\uAED8
      \uD575\uD3ED\uD0C4\uC774 \uD3ED\uD314\uD588\uB2E4."
  - text: "\uBBF8\uC6C0\uBC1B\uB294 \uC54C\uD30C\uCE74\uB294 \uB4DC\uB514\uC5B4 \uBCF5\uC218\uC5D0
      \uC131\uACF5\uD588\uB2E4\uACE0\n\uC0DD\uAC01\uD558\uBA70 \uD6C4\uB828\uD558\uAC8C
      \uC7A0\uC790\uB9AC\uC5D0 \uB4E4\uC5C8\uB2E4."
  - text: "\"\uD50C\uB808\uC774 \uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.\""
  - text: "[\uC81C\uC791]\n\uAE40\uD0DC\uC900, \uAC15\uC720, \uC870\uD55C\uACB0,
      \uC815\uC9C0\uD55C, \uC815\uC7AC\uADFC, \uD64D\uC9C0\uD6C4"
  displayText: {fileID: 1995559013}
  fadeOutDuration: 0.5
  fadeInDuration: 0.5
  fadeOutEase: 5
  fadeInEase: 6
  loopSequence: 0
