  messageTxt: {fileID: 3598640196255251062}
  tipTxt: {fileID: 4580184738690408357}
  transitionDuration: 2
  tipMessages:
  - "\uC644\uBCBD\uD788 \uC77C\uC5B4\uC11C\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uC5D0\uC11C
    \uBC1C\uC0AC\uB97C \uB204\uB974\uBA74 \uD0C4\uC54C\uC774 \uC774\uC0C1\uD55C\uACF3\uC73C\uB85C
    \uB0A0\uC544\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "RIFLE\uC740 \uC801\uB2F9\uD788 \uBCA8\uB7F0\uC2A4\uAC00 \uC7A1\uD78C \uCD1D\uC785\uB2C8\uB2E4."
  - "SMG\uB294 \uC911/\uADFC\uAC70\uB9AC\uC5D0\uC11C \uC131\uB2A5\uC744 \uBC1C\uD718\uD569\uB2C8\uB2E4."
  - "\uAE30\uAD00\uB2E8\uCD1D\uC740 \uD654\uB825 \uC9C0\uC6D0\uC5D0 \uD6A8\uACFC\uC801\uC785\uB2C8\uB2E4."
  - "\uC0F7\uAC74\uC740 \uADFC\uAC70\uB9AC \uC801\uC744 \uCC98\uCE58\uD558\uAE30
    \uC720\uC6A9\uD569\uB2C8\uB2E4."
  - "\uC800\uACA9\uCD1D\uC740 \uBA40\uB9AC\uC788\uB294 \uC0C1\uB300\uB97C \uD55C\uBC88\uC5D0
    \uBCF4\uB0B4\uAE30 \uC88B\uC740 \uCD1D\uAE30\uC785\uB2C8\uB2E4."
